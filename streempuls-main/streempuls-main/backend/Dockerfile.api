# ============================================================================
# StreamPulse - Backend API (Express) Dockerfile
# ============================================================================
FROM node:22-alpine

# Runtime tools: curl + ca-certificates for healthcheck probes (TLS).
# busybox already ships wget on Alpine, used as the healthcheck fallback.
RUN apk add --no-cache curl ca-certificates

WORKDIR /app

# --------------------------------------------------------------------------
# Dependency layer (cached unless package files change)
# Copy package.json + package-lock.json BEFORE source code for optimal
# Docker layer caching.
# --------------------------------------------------------------------------
COPY package.json package-lock.json ./

# Deterministic, reproducible install. `npm ci` requires package-lock.json
# and installs exactly the locked versions (faster & safer than `npm install`).
RUN npm ci --no-audit --no-fund

# --------------------------------------------------------------------------
# Application layer
# --------------------------------------------------------------------------
COPY . .

# Expose the API port
EXPOSE 4000

# Resilient healthcheck: busybox wget primary, curl fallback.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD wget -q -O - http://127.0.0.1:4000/health > /dev/null || curl -fs http://127.0.0.1:4000/health > /dev/null || exit 1

# Start the Express API gateway
CMD ["npm", "start"]
