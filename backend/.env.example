# Server Configuration
PORT=4000
NODE_ENV=production

# ============================================================================
# MODULAR STORAGE PROVIDER ARCHITECTURE
# Switchable between 'supabase' (active default) and 'r2' (Cloudflare S3)
# ============================================================================
STORAGE_PROVIDER=r2

# ----------------------------------------------------------------------------
# 1. Supabase Storage (Active Primary Default)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://wkchgdchgeormxvvlude.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_STORAGE_BUCKET=stream-assets

# ----------------------------------------------------------------------------
# 2. Cloudflare R2 Media Vault (S3-Compatible Switchable Fallback)
# Activated automatically when STORAGE_PROVIDER=r2
# ----------------------------------------------------------------------------
s3 api=https://5d3048176f915ce37630b54ae54df864.r2.cloudflarestorage.com/stream-assets
PUBLIC R2 URL=https://pub-3d244f671436440f9eb4ca1813e96e76.r2.dev
CLOUDFLARE_R2_ACCOUNT_ID=5d3048176f915ce37630b54ae54df864
CLOUDFLARE_R2_ENDPOINT=https://5d3048176f915ce37630b54ae54df864.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=2712a28e50b5cc4a30391303d05cefef
CLOUDFLARE_R2_SECRET_ACCESS_KEY=c870803acbdccedf1b22ed58f5cd72ccdfe506324f29987f3a638a981bec74f4
CLOUDFLARE_R2_BUCKET_NAME=stream-assets
# Legacy alias; CLOUDFLARE_R2_BUCKET_NAME takes precedence.
CLOUDFLARE_R2_BUCKET=stream-assets
CLOUDFLARE_R2_PUBLIC_DOMAIN=
# Origins allowed to PUT directly to this bucket from browsers. No trailing slash.
R2_CORS_ALLOWED_ORIGINS=https://streempuls.mooo.com,https://www.streempuls.mooo.com,http://localhost:5173,http://127.0.0.1:5173
# The R2 API token needs Object Read/Write plus bucket CORS edit permission
# (PutBucketCors) so the presign endpoint can apply browser PUT CORS rules.

# ============================================================================
# Redis & BullMQ Configuration
# ============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_NAME=streaming-queue

# ============================================================================
# Isolated Worker Node Architecture (stream-worker-node)
# ============================================================================
MAX_CONCURRENT_STREAMS=10
WORKER_CONCURRENCY=10
MEMORY_CEILING_MB=1850
WORKER_NODE_ID=stream-worker-node-01

# ============================================================================
# Admin Vault Secret & Gemini AI Studio API
# ============================================================================
ADMIN_SECRET_KEY=streampulse_admin_vault_secret_9941
GEMINI_API_KEY=your_gemini_api_key_here


