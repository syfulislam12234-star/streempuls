# Server Configuration
PORT=8000
NODE_ENV=production

# ============================================================================
# MODULAR STORAGE PROVIDER ARCHITECTURE
# Switchable between 'supabase' (active default) and 'r2' (Cloudflare S3)
# ============================================================================
STORAGE_PROVIDER=supabase

# ----------------------------------------------------------------------------
# 1. Supabase Storage (Active Primary Default)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://wkchgdchgeormxvvlude.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_STORAGE_BUCKET=stream-assets

# ----------------------------------------------------------------------------
# 2. Cloudflare R2 Media Vault (S3-Compatible Switchable Fallback)
# Activated automatically when STORAGE_PROVIDER=r2
# ----------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=stream-assets
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ============================================================================
# Redis & BullMQ Configuration
# ============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_NAME=streaming-queue

# ============================================================================
# Isolated Worker Node Architecture (stream-worker-node)
# ============================================================================
MAX_CONCURRENT_STREAMS=10
WORKER_CONCURRENCY=10
MEMORY_CEILING_MB=1850
WORKER_NODE_ID=stream-worker-node-01

# ============================================================================
# Admin Vault Secret & Gemini AI Studio API
# ============================================================================
ADMIN_SECRET_KEY=streampulse_admin_vault_secret_9941
GEMINI_API_KEY=your_gemini_api_key_here


