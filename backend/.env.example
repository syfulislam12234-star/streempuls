# Server Configuration
PORT=4000
NODE_ENV=production

# ============================================================================
# MODULAR STORAGE PROVIDER ARCHITECTURE
# Switchable between 'supabase' (active default) and 'r2' (Cloudflare S3)
# ============================================================================
STORAGE_PROVIDER=r2

# ----------------------------------------------------------------------------
# 1. Supabase Storage (Active Primary Default)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://wkchgdchgeormxvvlude.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_STORAGE_BUCKET=stream-assets

# ----------------------------------------------------------------------------
# 2. Cloudflare R2 Media Vault (S3-Compatible)
# Set real values in Coolify's backend-api service environment; never commit secrets.
# ----------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
# Optional; defaults to https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=stream-assets
# Legacy alias; CLOUDFLARE_R2_BUCKET_NAME takes precedence.
CLOUDFLARE_R2_BUCKET=stream-assets
CLOUDFLARE_R2_PUBLIC_DOMAIN=
# Origins allowed to PUT directly to this bucket from browsers. No trailing slash.
R2_CORS_ALLOWED_ORIGINS=https://streempuls.mooo.com,https://www.streempuls.mooo.com,http://localhost:5173,http://127.0.0.1:5173
# Configure the bucket CORS policy from backend/r2-cors-policy.json in Cloudflare R2.
# The browser sends a PUT with the exact signed Content-Type header.
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are accepted as credential aliases.

# ============================================================================
# Redis & BullMQ Configuration
# ============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_NAME=streaming-queue

# ============================================================================
# Isolated Worker Node Architecture (stream-worker-node)
# ============================================================================
MAX_CONCURRENT_STREAMS=10
WORKER_CONCURRENCY=10
MEMORY_CEILING_MB=1850
WORKER_NODE_ID=stream-worker-node-01

# ============================================================================
# Upload-time normalization (background job) - live streaming is ALWAYS copy
# ============================================================================
NORMALIZE_QUEUE_NAME=normalization-queue
NORMALIZE_CONCURRENCY=2
NORMALIZE_SLOT_TTL_SECONDS=3600
NORMALIZE_SLOT_RENEW_MS=25000
NORMALIZE_NICE_LEVEL=15
NORMALIZE_MAX_BUFFER_BYTES=536870912
NORMALIZE_TEMP_DIR=/tmp


# ============================================================================
# Admin Vault Secret & Gemini AI Studio API
# ============================================================================
ADMIN_SECRET_KEY=
GEMINI_API_KEY=your_gemini_api_key_here


