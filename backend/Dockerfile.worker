# ============================================================================
# StreamPulse - Isolated FFmpeg 24/7 Streaming Worker Dockerfile
# Lean Node 22 Alpine container equipped with FFmpeg & Tini init system
# ============================================================================

FROM node:22-alpine AS base

# Install FFmpeg, ca-certificates, and tini (for proper signal forwarding to child processes)
RUN apk add --no-cache \
    ffmpeg \
    ca-certificates \
    tini \
    curl

WORKDIR /app

RUN mkdir -p /app/video-cache && chown node:node /app/video-cache

# Install dependencies (leverage Docker layer caching)
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

# Copy worker application source files
COPY worker.js queue.js supabase.js storage.js healthcheck-worker.js r2ObjectUrl.js streamDestinations.js redisLease.js streamLeaseRunner.js streamDiagnostics.js streamOwnership.js localVideoSource.js videoCache.js ffmpegProgress.js workerShutdown.js ffmpegLifecycle.js cacheFallback.js ./

# Set environment
ENV NODE_ENV=production
ENV QUEUE_NAME=streaming-queue
ENV MAX_CONCURRENT_STREAMS=10
ENV MAX_RESTART_RETRIES=5
ENV MEMORY_CEILING_MB=1850
ENV UPLOADS_DIR=/app/uploads
ENV VIDEO_CACHE_DIR=/app/video-cache

# Non-root user for security (ensure user has permissions to execute ffmpeg)
USER node

# Healthcheck to verify worker node is responsive and heartbeating
HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=5 \
  CMD node healthcheck-worker.js || exit 1

# Use tini as init process to properly handle signals (SIGTERM/SIGINT) for child FFmpeg processes
ENTRYPOINT ["/sbin/tini", "--"]

# Start BullMQ isolated streaming worker
CMD ["node", "worker.js"]
