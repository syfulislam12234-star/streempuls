FROM node:22-alpine

# Install curl and ca-certificates for reliable healthcheck probes
RUN apk add --no-cache curl ca-certificates

WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install backend dependencies
RUN npm install

# Copy all files including pre-synced dist/ folder
COPY . .

# Expose the API and UI port
EXPOSE 4000

# Resilient Docker Healthcheck: Alpine wget fallback + curl with generous start-period
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD wget -q -O - http://127.0.0.1:4000/health > /dev/null || curl -fs http://127.0.0.1:4000/health > /dev/null || exit 1

# Start the application
CMD ["npm", "start"]
