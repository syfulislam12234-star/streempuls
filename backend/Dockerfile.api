FROM node:18-alpine

# Install curl and ca-certificates for reliable healthcheck probes
RUN apk add --no-cache curl ca-certificates

WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Use standard npm install to prevent exit code 1 version lock errors
RUN npm install && npm cache clean --force

# Copy the rest of the application code
COPY . .

# Expose the API port
EXPOSE 4000

# Resilient Docker Healthcheck: Alpine wget fallback + curl with generous start-period
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD wget -q -O - http://127.0.0.1:4000/health > /dev/null || curl -fs http://127.0.0.1:4000/health > /dev/null || exit 1

# Start the application
CMD ["npm", "start"]
