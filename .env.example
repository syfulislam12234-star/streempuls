# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# MODULAR STORAGE PROVIDER ARCHITECTURE (Pluggable Cloud Media Storage)
# ============================================================================
# Default: 'supabase' (No international card required, PostgreSQL 15+ & Storage)
# Future:  'r2'       (Cloudflare R2 S3-compatible, switch once international card is acquired)
STORAGE_PROVIDER="supabase"

# ----------------------------------------------------------------------------
# 1. Supabase Storage (Active Primary Default)
# ----------------------------------------------------------------------------
SUPABASE_URL="https://wkchgdchgeormxvvlude.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_STORAGE_BUCKET="stream-assets"

# ----------------------------------------------------------------------------
# 2. Cloudflare R2 Media Vault (S3-Compatible Switchable Fallback)
# Activated automatically whenever STORAGE_PROVIDER="r2"
# ----------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET="stream-assets"
CLOUDFLARE_R2_PUBLIC_DOMAIN=""

# ============================================================================
# REDIS & BULLMQ CONFIGURATION
# ============================================================================
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
QUEUE_NAME="streaming-queue"

# ============================================================================
# ISOLATED WORKER NODE ARCHITECTURE (stream-worker-node)
# ============================================================================
MAX_CONCURRENT_STREAMS="10"
WORKER_CONCURRENCY="10"
MEMORY_CEILING_MB="1850"
WORKER_NODE_ID="stream-worker-node-01"

# ============================================================================
# ZERO-ADMIN AUTONOMOUS ENGINE & MAXIMUM SECURITY TOKENS
# All secrets reside strictly server-side (Never exposed to client bundles)
# ============================================================================
AUTONOMOUS_ENGINE_ENABLED="true"
AUTONOMOUS_AUTO_SYNC_INTERVAL_SEC="30"
WEBHOOK_SIGNING_SECRET="sec_wh_streampulse_prod_vault_99218"
STREAM_ENCRYPTION_KEY="k_aes256_streampulse_enterprise_vault_01"

# ----------------------------------------------------------------------------
# Secure Mobile Financial Services (MFS) Gateway Credentials (bKash, Nagad, Rocket)
# Locked inside server environment / Supabase Vault
# ----------------------------------------------------------------------------
BKASH_APP_KEY="bkash_live_app_key_secured"
BKASH_APP_SECRET="bkash_live_app_secret_secured"
BKASH_USERNAME="bkash_live_merchant_usr"
BKASH_PASSWORD="bkash_live_merchant_pwd"

NAGAD_MERCHANT_ID="nagad_live_merchant_id"
NAGAD_PUBLIC_KEY="nagad_public_cert_key"
NAGAD_PRIVATE_KEY="nagad_private_cert_key"

ROCKET_MERCHANT_PIN="rocket_live_pin_secured"
ROCKET_API_SECRET="rocket_live_api_secret_secured"
ROCKET_CHANNEL_ID="rocket_prod_channel_01"

# ============================================================================
# UNIFIED VPS HOSTING & ADMIN SECRET SECURITY BRIDGE
# ============================================================================
PRIMARY_DOMAIN="streampulse.io"
ADMIN_SUBDOMAIN="admin.streampulse.io"
ADMIN_SECRET_KEY="streampulse_admin_vault_secret_9941"
