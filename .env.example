# Frontend (Vite) API configuration.
# For a separately hosted Coolify backend, set this to its public origin, e.g.
# https://streempuls.mooo.com (origin only; do not append /api).
# Vite embeds this value at build time, so rebuild/redeploy the frontend after changing it.
VITE_API_BASE_URL=https://streempuls.mooo.com

# Optional Vite development proxy target; defaults to http://127.0.0.1:4000.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
